# You normally never need to create or edit this file by hand — the
# first-run setup wizard (/setup.php) writes it for you: database
# connection, AI provider, admin account, and optional advanced settings
# are all entered through the browser. This file exists as a reference
# for what ends up in .env, and for hand-editing afterward (e.g. to
# switch AI provider, or set up SMTP the wizard's "advanced" stage
# skipped). Never commit .env itself — .htaccess also blocks direct web
# access to it.

# --- Database (create this via your host's cPanel > MySQL Databases;
# the wizard's first stage asks for these same values) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=changeme_dbname
DB_USER=changeme_dbuser
DB_PASS=change-me
# Some hosts prefix DB names/users with your account name automatically
# (e.g. cpaneluser_archive) — use exactly what cPanel shows you. Some hosts
# also route MySQL through a separate host with a non-default port instead
# of localhost:3306 — check your DB panel.

# --- AI provider ---
# Optional but recommended: powers the Ask tab, the Content page's
# narrative-connection notes, and URL-content suggestion analysis —
# without a key, Browse still works but Ask errors and new content is
# saved without an AI note/suggestions.
#
# AI_PROVIDER is "anthropic" (console.anthropic.com) or "openai". The
# "openai" adapter also works with any OpenAI-compatible endpoint —
# Groq, DeepSeek, OpenRouter, Azure OpenAI, a local Ollama/LM Studio
# server, etc. — by pointing AI_BASE_URL at it.
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-...
# Optional — sensible default used per provider if left blank
# (claude-sonnet-5 for anthropic, gpt-4o for openai).
AI_MODEL=
# Only used when AI_PROVIDER=openai. Leave blank for real OpenAI;
# set to your provider's own base URL otherwise, e.g.
# https://api.groq.com/openai/v1
AI_BASE_URL=
# Sampling temperature for every AI call (Ask tab, narrative notes,
# suggestion extraction) — these are recall/citation tasks, not creative
# writing, so the default is low (0.2) to reduce paraphrase drift and
# quote invention. Set to the literal word "default" to omit the
# parameter entirely and let the provider use its own default — needed
# for some OpenAI-shaped backends/reasoning models that reject any
# temperature other than their fixed one.
AI_TEMPERATURE=0.2

# Random long string used to sign session-related tokens and the email
# approve/reject links. The wizard generates this for you automatically —
# you'd only set it by hand if migrating an existing .env.
#   php -r "echo bin2hex(random_bytes(32)), \"\n\";"
SESSION_SECRET=change-me-too

# Where signup-approval notifications are sent. Separate from the admin
# account's own email so notifications can go to a different inbox. Falls
# back to the admin's email if left blank.
NOTIFY_EMAIL=

# Public URL this app is reached at (no trailing slash). On a normal
# HTTP request this is only a fallback — email links actually use the
# CURRENT subject's own hostname (see "Multiple subjects" in README.md),
# since every subject has a different one. This value only matters for
# CLI contexts with no resolved subject (e.g. a one-off script), so it's
# safe to leave as your main/first subject's URL.
APP_URL=https://archive.example.com

# --- Outgoing email ---
# Most shared hosts also give you a mailbox on the same domain (e.g. via
# cPanel Email Accounts) whose SMTP details work here (host is usually
# mail.yourdomain.com, port 587 with SMTP_SECURE=false for STARTTLS, or 465
# with SMTP_SECURE=true for implicit TLS — match these two correctly or
# you'll get a TLS handshake error). Some hosts route SMTP through a
# separate hostname whose TLS certificate doesn't match "mail.yourdomain.com"
# — if STARTTLS fails with a certificate mismatch, check your host's docs
# for the actual SMTP hostname to use. Leave SMTP_HOST blank to skip email
# entirely — signups still work, check the Admin page instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Family Archive <no-reply@example.com>

# Parent directory holding EVERY subject's uploaded family content and
# backups, outside the web root — see "Multiple subjects" in README.md.
# Each subject's own files live under ARCHIVE_ROOT_BASE/{slug}/,
# computed automatically; you never set a per-subject path yourself. The
# core archive itself (people, places, timeline, quotes, testimony)
# lives in the database, not on disk — this is only for uploaded files
# and backups. Default assumes the app sits one level below this
# folder; an absolute path works too.
ARCHIVE_ROOT_BASE=..

# --- Multiple subjects ---
# Required before a second (or later) subject can be added on a new
# hostname (see README.md's "Multiple subjects" section) — a visitor to
# an unrecognized hostname must supply this before the "add a subject"
# wizard will run. Not needed for your very first subject. Generate a
# random value, e.g.:
#   openssl rand -hex 24
SUBJECT_SETUP_SECRET=

# --- Backup & Restore (/admin_backup.php, /master_admin_backup.php) ---
# Applies independently per subject (each keeps its own newest N) as
# well as to the master admin's whole-site backups — not configurable
# per subject. How many backups to keep — the oldest are deleted
# automatically once there are more than this (applies to both manual
# and automatic backups). 0 keeps everything and never prunes.
BACKUP_RETENTION_COUNT=14
# How often an automatic backup should run, in hours, per subject. 0
# (default) means automatic backups are off — the only way a backup is
# made is the "Create backup now" button on a backup page. To actually
# enable automatic backups, set this AND point a host cron job at
# cron_backup.php (which dispatches across every subject automatically)
# — see README's "Backup & Restore" section, since this app has no
# long-running process of its own to schedule anything from.
BACKUP_AUTO_INTERVAL_HOURS=0
# Only needed if your host's cron can only hit a URL (not run `php
# cron_backup.php` directly) — set this to a random string and have cron
# request https://<a-subjects-hostname>/cron_backup.php?token=that-string
# (one line per subject this way, since an HTTP hit only ever resolves
# the one subject whose hostname it targets — a CLI cron job dispatches
# across every subject in one line instead, see README). Leave blank
# (default) to refuse cron_backup.php over HTTP entirely; a
# CLI-triggered cron job never needs this.
BACKUP_CRON_SECRET=

# Optional
CHAT_RATE_LIMIT=60
SIGNUP_RATE_LIMIT=10
# Failed logins are tracked per email address; after this many within the
# window, further attempts against that address are locked out until it
# passes (doesn't affect other accounts or reveal whether the address
# has a real account).
LOGIN_ATTEMPT_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900
# Password-reset emails requested per IP address, per hour.
FORGOT_PASSWORD_RATE_LIMIT=5
